# The API image copies only pyproject.toml, src/ and quietpost.yaml. Everything
# else stays out of the build context: it is slow to send (.venv, node_modules)
# or private (.quietpost or .cortex memory, .env, the agent's workspace).
.git
.github
.venv
venv
.env
.env.*
.quietpost
.cortex
workspace
ui
evals
tests
docs
infra
**/__pycache__
# The UI has its own image; a bundled copy built locally stays out of the API's.
src/quietpost/web
**/*.pyc
.pytest_cache
.mypy_cache
.ruff_cache
coverage.xml
